# Porta HTTP da API
PORT=3333

# Banco de dados
# - Vazio: usa PGlite (Postgres embutido, salvo em ./.pglite). Ideal para desenvolvimento.
# - Produção: string de conexão PostgreSQL (Neon, Supabase, Render, Railway...)
DATABASE_URL=
# DATABASE_URL=postgres://usuario:senha@host:5432/rede_comunidade?sslmode=require

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-bem-longo

# Origens liberadas no CORS (separadas por vírgula). Vazio = todas (ok para app mobile).
CORS_ORIGINS=

# Quantas confirmações de moradores validam uma rota automaticamente
LIMIAR_VALIDACAO_ROTA=3

# Admin inicial criado pelo `npm run db:seed`
ADMIN_NOME=Presidente
ADMIN_EMAIL=presidente@comunidade.com
ADMIN_CPF=
ADMIN_SENHA=

# E-mail (recuperação de senha). Sem SMTP_HOST, o link é apenas impresso no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rede Comunidade <nao-responda@comunidade.com>"
# Link enviado no e-mail; {token} é substituído pelo token de redefinição
RESET_SENHA_URL=rede-comunidade://redefinir-senha?token={token}
